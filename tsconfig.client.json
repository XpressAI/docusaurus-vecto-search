{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@docusaurus/module-type-aliases"]
  },
  "include": ["src/theme/**/*.ts", "src/theme/**/*.tsx", "src/types.ts"],
  "exclude": ["src/server/**/*"]
}
